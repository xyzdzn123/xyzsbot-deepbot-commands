# Environment variables for xyzBOT Discord Bot
# Copy this file to .env and fill in your actual tokens

# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Twitch API Credentials
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# YouTube API Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Streamer Configuration
STREAMER_TWITCH_USERNAME=xyzdzn123
STREAMER_YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here

# Stream Link Configuration (customizable)
TWITCH_STREAM_URL=https://twitch.tv/xyzdzn123
YOUTUBE_STREAM_URL=https://youtube.com/@xyzdzn123/live

# Check intervals (seconds)
STREAM_CHECK_INTERVAL=60

# Bot Configuration
DEFAULT_NOTIFICATION_CHANNEL_NAME=general